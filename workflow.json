{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "uroclinic-neuroventas",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst mensaje = `🚨 *NUEVO LEAD - UROCLINIC* 🚨\\n\\n` +\n  `👤 *Nombre:* ${data.nombre || 'No especificado'}\\n` +\n  `📱 *Teléfono:* ${data.telefono || 'No especificado'}\\n` +\n  `💡 *Servicio:* ${data.servicio || 'General'}\\n` +\n  `📊 *Etapa:* ${data.etapa || 'Nuevo Lead'}\\n\\n` +\n  `⚡ *¡Atender de inmediato!*`;\n\nreturn { json: { chat_id: \"TU_CHAT_ID\", text: mensaje, parse_mode: \"Markdown\" } };"
      },
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [690, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Formatear Mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Mensaje": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
